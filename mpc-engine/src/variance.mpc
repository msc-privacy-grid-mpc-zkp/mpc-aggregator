program.use_edabit(True)

# KRITIČNO: Postavi preciznost PRIJE svih operacija
# f=20 daje preciznost ~1e-6, k=60 daje range do ~500 milijardi
# 2*k = 120 < 128 (ring size) - constraint je zadovoljen
sfix.set_precision(26, 56)
sfix.round_nearest = True

NUM_PARTIES = @@NUM_PARTIES@@
MAX_METERS = 1000
SCALER = 1000.0

print_ln("=========== MPC START (Nodes: %s) ===========", NUM_PARTIES)

# 1. Prikupljanje n_shares 
n_shares = sint(0)
for p in range(NUM_PARTIES):
    p_n_share = sint.get_input_from(p)
    print_ln("🔍 [DEBUG MPC] Cvor %s poslao N-share: %s", p, p_n_share.reveal())
    n_shares += p_n_share
    
n_sec = sfix(n_shares)
print_ln("🔍 [DEBUG MPC] ===> Ukupan broj mjerila (N): %s", n_shares.reveal())

# 2. Vektorizovano prikupljanje ulaza 
p0_x = sint.get_input_from(0, size=MAX_METERS)
print_ln("🔍 [DEBUG MPC] Cvor 0 poslao sumu udjela: %s", sum(p0_x).reveal())
X_raw = p0_x

for p in range(1, NUM_PARTIES):
    p_x = sint.get_input_from(p, size=MAX_METERS)
    print_ln("🔍 [DEBUG MPC] Cvor %s poslao sumu udjela: %s", p, sum(p_x).reveal())
    X_raw += p_x

# Ukupna suma raw integera (prije ikakvog skaliranja ili prebacivanja u decimale)
print_ln("🔍 [DEBUG MPC] ===> TOTAL RAW SUM PRIJE DELJENJA I SCALERA: %s", sum(X_raw).reveal())

# ====================================================================
# OPTIMIZACIJA BEZ OVERFLOW-A: 
# Prvo prebacujemo u sfix i skaliramo (odmah smanjujemo veličinu brojeva)
# Množenje konstantom je jeftinije od deljenja
# Sa sfix.set_precision(20, 60) ovo je sada sigurno:
#   - sfix(X_raw): interno množi sa 2^20 (~10^6), ali X_raw/1000 ~ 10^9
#     => interni int ~ 10^9 * 10^6 = 10^15 < 2^60 ✓
# ====================================================================

inv_scaler = 1.0 / SCALER
X_scaled = sfix(X_raw) * inv_scaler

# Sada radimo sumu i dot_product nad skaliranim vrednostima.
# Vrijednosti su sada oko 1.5 po elementu, kvadrati neće prelivati.
sum_x = X_scaled.sum()
sum_x2 = sfix.dot_product(X_scaled, X_scaled)

# OPTIMIZACIJA: Izračunavamo 1/n jednom (1 tajno deljenje) i množimo
inv_n = 1.0 / n_sec

mean = sum_x * inv_n
variance = (sum_x2 * inv_n) - (mean * mean)

print_ln("RESULT_MEAN: %s", mean.reveal())
print_ln("RESULT_VARIANCE: %s", variance.reveal())