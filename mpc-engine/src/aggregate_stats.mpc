program.use_edabit(True)

# IMPORTANT: Set fixed-point precision BEFORE all operations
sfix.set_precision(26, 56)
sfix.round_nearest = True

import os
# Dynamically fetch NUM_PARTIES to avoid 'sed' command corruption in Docker
NUM_PARTIES = int(os.environ.get('NUM_PARTIES', '3'))
MAX_METERS = 1000
SCALER = 1000.0

print_ln("=========== MPC START (Nodes: %s) ===========", NUM_PARTIES)

# 1. Gather n_shares
n_shares = sint(0)
for p in range(NUM_PARTIES):
    p_n_share = sint.get_input_from(p)
    print_ln("[DEBUG MPC] Node %s sent N-share: %s", p, p_n_share.reveal())
    n_shares += p_n_share
    
n_sec = sfix(n_shares)
print_ln("[DEBUG MPC] ===> Total number of meters (N): %s", n_shares.reveal())

# 2. Vectorized input gathering
p0_x = sint.get_input_from(0, size=MAX_METERS)
X_raw = p0_x

for p in range(1, NUM_PARTIES):
    p_x = sint.get_input_from(p, size=MAX_METERS)
    X_raw += p_x

print_ln("[DEBUG MPC] ===> TOTAL RAW SUM BEFORE SCALING: %s", sum(X_raw).reveal())

# ====================================================================
# AVOIDING OVERFLOW & SECRET DATA SANITIZATION (PRE-AGGREGATION)
# ====================================================================
inv_scaler = 1.0 / SCALER
X_scaled = sfix(X_raw) * inv_scaler

# SANITY CHECK: Each meter must be in range [0, 10000] W (scaled to [0, 10.0])
MAX_ALLOWED_SCALED = sfix(10.0)

# Secret vectorized checks: 1 if valid, 0 if poisoned
is_positive = (X_scaled >= sfix(0.0))
is_not_huge = (X_scaled <= MAX_ALLOWED_SCALED)
is_valid_input = is_positive * is_not_huge

# Sanitization: Poisoned data becomes 0.0, honest data remains intact. 
X_clean = X_scaled * is_valid_input

# Sum and dot_product strictly on sanitized values
sum_x = X_clean.sum()
sum_x2 = sfix.dot_product(X_clean, X_clean)

# ====================================================================
# DIVISION-BY-ZERO PROTECTION (EAGER EVAL FIX)
# ====================================================================
n_is_safe = n_sec > sfix(1)

# The divisor must physically never be 0 in any evaluation branch
# Use conditional multiplication: if n_is_safe=1, use n_sec; if n_is_safe=0, use 1.0
safe_divisor = n_sec * sfix(n_is_safe) + sfix(1.0) * (1 - sfix(n_is_safe))
inv_n_unsafe = 1.0 / safe_divisor

# If n_sec <= 1, inv_n_safe becomes 0.0
inv_n_safe = inv_n_unsafe * sfix(n_is_safe)

# ====================================================================
# ADDITIONAL METRICS FOR PYTHON BRIDGE
# ====================================================================
total_power = sum_x

# If n_is_safe == 0, mean will be 0.0
mean = total_power * inv_n_safe

# If n_is_safe == 0, variance will be 0.0
variance = (sum_x2 * inv_n_safe) - (mean * mean)
variance = variance * sfix(n_is_safe)

print_ln("RESULT_TOTAL_POWER: %s", total_power.reveal())
print_ln("RESULT_MEAN: %s", mean.reveal())
print_ln("RESULT_VARIANCE: %s", variance.reveal())
